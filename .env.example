# ==============================================================================
# SECURE ONLINE CODING ASSESSMENT PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Connection (SQL Server)
# If using local SQL Server / Docker container:
ConnectionStrings__DefaultConnection="Server=localhost,1433;Database=CodingAssessmentDb;User Id=sa;Password=Your_password123;TrustServerCertificate=True;MultipleActiveResultSets=true"

# JWT Authentication Secret (Must be at least 32 characters long)
JwtSettings__SecretKey="SecureCodingAssessmentPlatformSecretKey2026!MustBe32BytesLong"
JwtSettings__Issuer="CodingAssessmentApi"
JwtSettings__Audience="CodingAssessmentClient"
JwtSettings__ExpirationMinutes=480

# Judge0 Code Execution API Integration
# ------------------------------------------------------------------------------
# Option A: RapidAPI Judge0 CE (Recommended for quick testing)
# Sign up at https://rapidapi.com/judge0-official/api/judge0-ce and copy your key:
Judge0__BaseUrl="https://judge0-ce.p.rapidapi.com"
Judge0__ApiKey="YOUR_RAPIDAPI_KEY_HERE"
Judge0__RapidApiHost="judge0-ce.p.rapidapi.com"
Judge0__UseRapidApi=true

# Option B: Self-Hosted Judge0 (Docker)
# Judge0__BaseUrl="http://localhost:2358"
# Judge0__ApiKey=""
# Judge0__UseRapidApi=false

# Code Execution Security Limits
Judge0__CpuTimeLimit=3.0
Judge0__MemoryLimitKb=128000

# Frontend API URL
VITE_API_URL="http://localhost:5000/api"
